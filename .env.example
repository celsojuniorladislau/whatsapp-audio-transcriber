# Copy to .env and replace placeholders locally; no GPT/OpenAI API key is needed.
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=replace_with_a_long_random_api_key
EVOLUTION_INSTANCE=personal
WEBHOOK_SECRET=replace_with_a_different_long_random_secret
DATABASE_PATH=/data/messages.sqlite3
MAX_AUDIO_BYTES=20971520
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
POSTGRES_DB=evolution_db
POSTGRES_USER=evolution
POSTGRES_PASSWORD=replace_with_alphanumeric_random_password
